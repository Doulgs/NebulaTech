{
  "expo": {
    "name": "Nébula Finance",
    "slug": "nebula-finance",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/nebula-icon.png",
    "scheme": "nebula",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/nebula-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0C0C16",
        "foregroundImage": "./assets/images/nebula-orb.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/nebula-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0C0C16",
          "image": "./assets/images/nebula-orb.png",
          "imageWidth": 180
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
